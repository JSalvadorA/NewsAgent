# .gitignore para NewsAgent

# ENTORNO VIRTUAL - NUNCA INCLUIR
/.env/
/env/
/venv/
/.venv/

# Directorios que no queremos incluir
/cache/*
/logs/*
/output/*
/temp/*

# Archivos de Python estándar para ignorar
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

## Ignorar archivos temporales adicionales (sugerencia nueva)
# Ignora todos los archivos con extensiones comunes generadas, excepto PDFs
*.tmp
*.log  # Si no está cubierto por /logs/*
*.bak
*.json  # Excepto si son configuraciones estáticas; usa ! para incluir excepciones si necesario, e.g., !config.json

# Archivos temporales y de sistema
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Mantener estos .gitkeep para la estructura
!cache/.gitkeep
!logs/.gitkeep
